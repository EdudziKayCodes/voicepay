# Copy this file to .env and fill it in. Never commit .env to GitHub.

# Free key from the Groq console
GROQ_API_KEY=paste-your-key-here

# Face ID / Touch ID is tied to these two values.
# On your laptop (localhost) leave them as they are.
# For a phone demo, use your https tunnel address instead, for example:
#   RP_ID=abc123.ngrok-free.app
#   ORIGIN=https://abc123.ngrok-free.app
RP_ID=localhost
ORIGIN=http://localhost:5000

# Optional owner token for private diagnostic endpoint access.
SETUP_TOKEN=

# Firebase Web app config (these are identifiers, not server secrets).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Firebase Admin service account JSON. Keep private; never commit the filled value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional multilingual audio transcription fallback for browsers without speech recognition.
# Audio is sent from this server to Groq and is not stored by VoicePay.
# AUDIO_MODEL=whisper-large-v3-turbo

# Optional: change the models (main model first, backup second)
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Safety switches (defaults shown)
# ALLOW_RESET=1         enables the demo-only reset button (default: off)
# REDIS_URL=            shared rate-limit storage for multi-worker/public deployments
# PROXY_FIX_HOPS=1      trust forwarded client IP/scheme only when exactly one trusted proxy is in front
# VOICEPAY_LEDGER_DB=   optional path for SQLite ledger (use a persistent mounted disk)
